{
  "mcpServers": {
    "cloudbase-remote": {
      "httpUrl": "https://tcb-api.cloud.tencent.com/mcp/v1"
    },
    "cloudbase-local": {
      "command": "npx",
      "args": [
        "npm-global-exec@latest",
        "@cloudbase/cloudbase-mcp@latest"
      ],
      "env": {
        "INTEGRATION_IDE": "Gemini"
      }
    }
  }
}
